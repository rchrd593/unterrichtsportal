
---
const jahrgaenge = [
  {
    nummer: "10",
    titel: "10. Jahrgangsstufe",
    beschreibung: "Unterrichtsmaterialien und Anwendungen",
    link: "/metalltechnik/jahrgangsstufe-10/",
  },
  {
    nummer: "11",
    titel: "11. Jahrgangsstufe",
    beschreibung: "Unterrichtsmaterialien und Anwendungen",
    link: "/metalltechnik/jahrgangsstufe-11/",
  },
  {
    nummer: "12",
    titel: "12. Jahrgangsstufe",
    beschreibung: "Unterrichtsmaterialien und Anwendungen",
    link: "/metalltechnik/jahrgangsstufe-12/",
  },
];
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Metalltechnik | Lernportal</title>
  </head>
  <body>
    <main>
      <a href="/">← Zur Startseite</a>

      <h1>⚙️ Metalltechnik</h1>
      <p>Wähle deine Jahrgangsstufe.</p>

      <div class="karten">
        {jahrgaenge.map((jahr) => (
          <a class="karte" href={jahr.link}>
            <span class="nummer">{jahr.nummer}</span>
            <h2>{jahr.titel}</h2>
            <p>{jahr.beschreibung}</p>
            <span class="link">Zum Bereich →</span>
          </a>
        ))}
      </div>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    padding: 32px 20px;
    background: #f5f7fb;
    color: #20243a;
    font-family: system-ui, sans-serif;
  }

  main {
    max-width: 1000px;
    margin: 40px auto;
  }

  a {
    color: #5145cd;
    text-decoration: none;
  }

  h1 {
    margin-top: 36px;
    font-size: 42px;
  }

  .karten {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 20px;
    margin-top: 32px;
  }

  .karte {
    padding: 26px;
    background: white;
    color: #20243a;
    border: 1px solid #e1e5ef;
    border-radius: 16px;
    transition: transform 0.2s;
  }

  .karte:hover {
    transform: translateY(-3px);
    border-color: #8175ed;
  }

  .nummer {
    display: inline-grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: #e9e7ff;
    color: #5145cd;
    font-size: 22px;
    font-weight: bold;
  }

  .karte h2 {
    margin-top: 22px;
  }

  .karte p {
    color: #686e82;
    line-height: 1.6;
  }

  .link {
    display: inline-block;
    margin-top: 12px;
    font-weight: bold;
  }
</style>
