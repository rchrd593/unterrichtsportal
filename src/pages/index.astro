
---

const faecher = [
  {
    name: "Physik",
    icon: "⚛️",
    beschreibung: "Mechanik, Elektrizität und Optik",
    link: "/physik/",
  },
  {
    name: "Metalltechnik",
    icon: "⚙️",
    beschreibung: "Werkstoffe, Fertigung und Technik",
    link: "/metalltechnik/",
  },
];

---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mein Lernportal</title>
    <meta
      name="description"
      content="Materialien, Rechner und interaktive Anwendungen für den Unterricht."
    />
  </head>
  <body>
    <header class="kopf">
      <a class="logo" href="/">✦ Mein Lernportal</a>
      <nav>
        <a href="#faecher">Meine Fächer</a>
        <a href="#materialien">Materialien</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <span class="label">MEINE DIGITALE UNTERRICHTSWELT</span>
        <h1>Lernen. Entdecken.<br /><span>Verstehen.</span></h1>
        <p>
          Hier findest du Unterrichtsmaterialien, interaktive Rechner,
          Übungen und hilfreiche Anwendungen an einem Ort.
        </p>
        <a class="hauptbutton" href="#faecher">Fächer entdecken ↓</a>
      </section>

      <section class="abschnitt" id="faecher">
        <div class="abschnitt-kopf">
          <div>
            <span class="label">ÜBERSICHT</span>
            <h2>Meine Fächer</h2>
          </div>
          <span class="anzahl">04 Bereiche</span>
        </div>

        <div class="karten">
          {faecher.map((fach) => (
            <a class="karte" href={fach.link}>
              <span class="fach-icon">{fach.icon}</span>
              <h3>{fach.name}</h3>
              <p>{fach.beschreibung}</p>
              <span class="pfeil">Bereich öffnen ↗</span>
            </a>
          ))}
        </div>
      </section>

      <section class="abschnitt" id="materialien">
        <span class="label">SCHNELLZUGRIFF</span>
        <h2>Was brauchst du heute?</h2>
        <div class="materialien">
          <a href="#faecher">📄 Arbeitsblätter</a>
          <a href="#faecher">🧮 Interaktive Rechner</a>
          <a href="#faecher">✏️ Aufgaben & Lösungen</a>
          <a href="#faecher">🎬 Videos & Präsentationen</a>
        </div>
      </section>
    </main>

    <footer>
      <span>✦ Mein Lernportal</span>
      <span>Eine digitale Sammlung für den Unterricht</span>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f7f8fc;
    color: #20243a;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, sans-serif;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .kopf {
    min-height: 76px;
    padding: 20px max(6%, calc((100% - 1120px) / 2));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    background: #fff;
    border-bottom: 1px solid #e9eaf2;
  }

  .logo {
    font-weight: 800;
    font-size: 19px;
    letter-spacing: -0.6px;
  }

  .logo:first-letter {
    color: #6457e8;
  }

  nav {
    display: flex;
    gap: 24px;
    font-size: 14px;
    color: #666b80;
  }

  .hero {
    padding: 86px 24px 92px;
    text-align: center;
    background:
      radial-gradient(ellipse at 50% 0%, #e8e5ff 0%, transparent 65%),
      #f7f8fc;
  }

  .label {
    color: #695be7;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.8px;
  }

  h1 {
    margin: 20px 0;
    font-size: clamp(42px, 7vw, 76px);
    line-height: 1.06;
    letter-spacing: -3px;
  }

  h1 span {
    color: #695be7;
  }

  .hero p {
    max-width: 570px;
    margin: 0 auto 30px;
    color: #70758a;
    line-height: 1.8;
    font-size: 16px;
  }

  .hauptbutton {
    display: inline-block;
    padding: 14px 23px;
    border-radius: 12px;
    color: white;
    background: #695be7;
    font-size: 14px;
    font-weight: 700;
    box-shadow: 0 8px 22px #695be733;
  }

  .abschnitt {
    max-width: 1120px;
    margin: 0 auto;
    padding: 38px 24px;
  }

  .abschnitt-kopf {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    margin-bottom: 25px;
  }

  h2 {
    margin: 9px 0 0;
    font-size: 30px;
    letter-spacing: -1px;
  }

  .anzahl {
    color: #777b8f;
    font-size: 13px;
  }

  .karten {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .karte {
    padding: 24px 20px;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background: white;
    border: 1px solid #e9eaf2;
    border-radius: 18px;
    transition: transform 160ms, box-shadow 160ms;
  }

  .karte:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px #25264b0d;
  }

  .fach-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: #f0eeff;
    font-size: 24px;
  }

  h3 {
    margin: 20px 0 8px;
    font-size: 17px;
  }

  .karte p {
    margin: 0 0 20px;
    color: #777b8f;
    font-size: 13px;
    line-height: 1.6;
  }

  .pfeil {
    margin-top: auto;
    color: #695be7;
    font-size: 12px;
    font-weight: 700;
  }

  .materialien {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 24px;
  }

  .materialien a {
    padding: 20px;
    background: white;
    border: 1px solid #e9eaf2;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
  }

  footer {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 30px 6%;
    margin-top: 45px;
    border-top: 1px solid #e9eaf2;
    color: #777b8f;
    font-size: 12px;
  }

  @media (max-width: 760px) {
    .kopf {
      align-items: flex-start;
      flex-direction: column;
    }

    nav {
      flex-wrap: wrap;
      gap: 16px;
    }

    .hero {
      padding: 65px 22px;
    }

    h1 {
      letter-spacing: -2px;
    }

    .karten {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .karte {
      padding: 18px 14px;
    }

    .materialien {
      grid-template-columns: 1fr;
    }

    footer {
      flex-direction: column;
    }
  }

  @media (max-width: 380px) {
    .karten {
      grid-template-columns: 1fr;
    }
  }
</style>
